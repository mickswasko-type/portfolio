---
import { getImage } from 'astro:assets';
import posterSrc from '../assets/mick-in-a-minute-poster.jpg';

// The poster is the video's own opening line, so it hooks people before it plays.
const poster = await getImage({ src: posterSrc, width: 720, format: 'webp', quality: 82 });
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The run-on sentence, clause by clause, exactly as it builds in the video.
const clauses = [
  'I can write a news story',
  'send it to thousands of people on Twitter',
  'publish it myself from the field, with my own photos and video',
  'package it for print, web, mobile and social, all at once',
  'tell an institution’s story, not just a city’s',
  'find the story hiding inside a spreadsheet',
  'help newer writers find their footing while the world changed faster than ever',
  'get to a first draft in a fraction of the time',
  'produce storyboards, clinical diagnostics white papers, ad copy and sales decks in the same week',
  'produce the whole campaign on my own: sell sheets, email sequences, infographics, product walkthroughs',
  'build the damn things.',
];
---

<div class="minute" data-minute>
  <div class="player">
    <video
      data-video
      muted
      playsinline
      preload="none"
      poster={poster.src}
      width="1080"
      height="1350"
      aria-label="Mick in a Minute: a 54-second animation of one sentence growing from 2008 to today"
      aria-describedby="minute-transcript"
    >
      <source src={`${base}video/mick-in-a-minute.mp4`} type="video/mp4" />
    </video>
    <button type="button" class="play" data-play aria-label="Play Mick in a Minute">
      <svg class="icon i-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" /></svg>
      <svg class="icon i-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1h3v10H2zM7 1h3v10H7z" /></svg>
      <svg class="icon i-replay" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1.5a4.5 4.5 0 1 1-4.3 3.2" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M0.6 1.6 1.7 5.2 5 3.6z" /></svg>
      <span class="label" data-play-label>Play</span>
    </button>
    <div class="bar" aria-hidden="true"><span class="fill" data-fill></span></div>
  </div>

  <div class="side">
    <h2>Eighteen years. One sentence.</h2>
    <p class="note">Fifty-four seconds, no sound needed.</p>
    <details class="read">
      <summary>Read it instead</summary>
      <div id="minute-transcript" class="transcript">
        <p>In 2008, everything I could do professionally fit in one sentence. That sentence kept growing.</p>
        <p class="runon">
          {
            clauses.map((c, i) => (
              <>
                {i > 0 && <span class="and">…and </span>}
                {c}{' '}
              </>
            ))
          }
        </p>
        <p>The sentence still starts the same. Now it’s just a run-on.</p>
      </div>
    </details>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-minute]').forEach((root) => {
    const video = root.querySelector<HTMLVideoElement>('[data-video]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const label = root.querySelector<HTMLElement>('[data-play-label]')!;
    const fill = root.querySelector<HTMLElement>('[data-fill]')!;
    let userPaused = false;
    let autoplayed = false;

    const sync = () => {
      const state = video.ended ? 'ended' : video.paused ? 'paused' : 'playing';
      root.dataset.state = state;
      const text = state === 'playing' ? 'Pause' : state === 'ended' ? 'Replay' : 'Play';
      label.textContent = text;
      btn.setAttribute('aria-label', `${text} Mick in a Minute`);
    };
    const play = () => {
      video.preload = 'auto';
      video.play().catch(() => {});
    };

    ['play', 'pause', 'ended'].forEach((e) => video.addEventListener(e, sync));
    video.addEventListener('timeupdate', () => {
      fill.style.width = `${(video.currentTime / (video.duration || 54)) * 100}%`;
    });

    btn.addEventListener('click', () => {
      if (video.ended) {
        video.currentTime = 0;
        userPaused = false;
        play();
      } else if (video.paused) {
        userPaused = false;
        play();
      } else {
        userPaused = true;
        video.pause();
      }
    });

    // Plays by itself once it's mostly on screen, pauses when it leaves, and never
    // restarts on its own after it ends. Reduced motion: it waits for a click.
    const io = new IntersectionObserver(
      ([e]) => {
        if (reduce.matches) return;
        if (e.isIntersecting) {
          if (!userPaused && !video.ended && (video.paused || !autoplayed)) {
            autoplayed = true;
            play();
          }
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.6 },
    );
    io.observe(video);
    sync();
  });
</script>

<style>
  .minute {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .player {
    position: relative;
    border: 2px solid var(--ink);
    box-shadow: 14px 14px 0 var(--ink);
    background: var(--paper);
    aspect-ratio: 4 / 5;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    left: 14px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 12px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .play:hover {
    background: #3a322b;
  }
  .icon {
    width: 12px;
    height: 12px;
    fill: currentColor;
    display: none;
  }
  [data-state='paused'] .i-play,
  [data-state='playing'] .i-pause,
  [data-state='ended'] .i-replay {
    display: block;
  }
  /* While it plays, the button steps back so it doesn't sit on the words. */
  [data-state='playing'] .play {
    opacity: 0;
    transition: opacity 0.3s;
  }
  .player:hover .play,
  .play:focus-visible {
    opacity: 1 !important;
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(26, 22, 19, 0.12);
  }
  .fill {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ink);
  }

  .side h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .note {
    font-family: var(--italic);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
    margin-top: 16px;
  }

  /* The written version stays out of the way until someone asks for it. */
  .read {
    margin-top: 22px;
  }
  .read summary {
    display: inline-block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    list-style: none;
    border-bottom: 1.5px solid currentColor;
    padding-bottom: 1px;
  }
  .read summary::-webkit-details-marker {
    display: none;
  }
  .read summary:hover {
    border-bottom-color: var(--accent);
  }
  .read[open] summary {
    margin-bottom: 16px;
  }
  .transcript p {
    font-size: 17px;
    line-height: 1.55;
    max-width: 56ch;
    margin-bottom: 12px;
  }
  .runon {
    color: var(--ink);
  }
  .and {
    color: var(--ink-soft);
    font-family: var(--italic);
    font-style: italic;
  }

  @media (max-width: 760px) {
    .minute {
      grid-template-columns: 1fr;
    }
    .player {
      max-width: 400px;
      margin: 0 14px 14px 0;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import tweets from '../data/tweets.json';
import avatar from '../assets/tweets/avatar.jpg';
import { apDate } from '../lib/format';


// AP style: "8:09 p.m.", "10 a.m." (Chicago time, as it showed when posted).
function apTime(hhmm: string) {
  const [h, m] = hhmm.split(':').map(Number);
  const h12 = h % 12 || 12;
  return `${h12}${m ? `:${String(m).padStart(2, '0')}` : ''} ${h < 12 ? 'a.m.' : 'p.m.'}`;
}

// @handles and #hashtags get tweet-blue, but stay plain text (never links).
const TAG = /([@#][A-Za-z0-9_]+)/;
const parts = (text: string) => text.split(TAG).map((chunk, i) => ({ chunk, tag: i % 2 === 1 }));

// Short one-liners read big, long lists step down so every card fits the same frame.
function size(text: string) {
  // Rough visual weight: characters plus a line's worth for every break.
  const weight = text.length + text.split('\n').length * 30;
  if (weight <= 150) return 'xl';
  if (weight <= 300) return 'lg';
  return 'md';
}

const total = tweets.length;
---

<div
  class="tweets"
  data-tweets
  data-index="0"
  role="region"
  aria-roledescription="carousel"
  aria-label="Selected tweets by Mick Swasko"
  tabindex="0"
>
  <div class="stage" data-stage>
    {
      tweets.map((t, i) => {
        return (
          <div
            class:list={['tweet', `size-${size(t.text)}`, { active: i === 0 }]}
            data-tweet
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i === 0 ? undefined : true}
          >
            <header class="head">
              <Image class="avatar" src={avatar} alt="" width={96} height={96} format="webp" loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="who">
                <span class="name">Mick Swasko</span>
                <span class="handle">@swasko</span>
              </span>
            </header>
            <div class="body">
              <blockquote class="text">{parts(t.text).map((p) => (p.tag ? <span class="tag">{p.chunk}</span> : p.chunk))}</blockquote>
            </div>
            <div class="byline">
              <time datetime={`${t.date}T${t.time}`}>
                {apTime(t.time)} · {apDate(t.date)}
              </time>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="controls">
    <button type="button" class="nav" data-tweet-step="-1" aria-label="Previous tweet">←</button>
    <div class="progress" aria-hidden="true">
      <span class="count" data-tweet-count>1 / {total}</span>
      <span class="bar"><span class="fill" data-tweet-fill style={`width: ${100 / total}%`}></span></span>
    </div>
    <button type="button" class="nav" data-tweet-step="1" aria-label="Next tweet">→</button>
  </div>
  <p class="sr-only" aria-live="polite" data-tweet-live></p>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-tweets]').forEach((root) => {
    // A fresh order for every visit (Fisher–Yates). All slides share one grid cell,
    // so reordering them can't shift the layout.
    const slides = [...root.querySelectorAll<HTMLElement>('[data-tweet]')];
    for (let i = slides.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [slides[i], slides[j]] = [slides[j], slides[i]];
    }
    const deck = root.querySelector<HTMLElement>('[data-stage]')!;
    slides.forEach((slide, i) => {
      deck.appendChild(slide);
      const first = i === 0;
      slide.classList.toggle('active', first);
      slide.classList.remove('enter-next', 'enter-prev');
      slide.inert = !first;
      if (first) slide.removeAttribute('aria-hidden');
      else slide.setAttribute('aria-hidden', 'true');
      slide.setAttribute('aria-label', `${i + 1} of ${slides.length}`);
    });
    const count = root.querySelector('[data-tweet-count]')!;
    const fill = root.querySelector<HTMLElement>('[data-tweet-fill]')!;
    const live = root.querySelector('[data-tweet-live]')!;
    const n = slides.length;
    let at = 0;

    function go(next: number) {
      const to = (next + n) % n;
      if (to === at) return;
      const dir = next > at ? 1 : -1;
      const from = slides[at];
      const into = slides[to];

      from.classList.remove('active', 'enter-next', 'enter-prev');
      from.setAttribute('aria-hidden', 'true');
      from.inert = true;

      into.classList.remove('enter-next', 'enter-prev');
      if (!reduce.matches) {
        void into.offsetWidth; // restart the entrance animation
        into.classList.add(dir > 0 ? 'enter-next' : 'enter-prev');
      }
      into.classList.add('active');
      into.removeAttribute('aria-hidden');
      into.inert = false;

      at = to;
      root.dataset.index = String(at);
      count.textContent = `${at + 1} / ${n}`;
      fill.style.width = `${((at + 1) / n) * 100}%`;
      live.textContent = `Tweet ${at + 1} of ${n}`;
    }

    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tweet-step]');
      if (b) go(at + Number(b.dataset.tweetStep));
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(at + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(at - 1);
      }
    });

    // Swipe: a mostly-horizontal drag of 40px or more turns the page.
    let x0 = 0;
    let y0 = 0;
    let tracking = false;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      x0 = e.clientX;
      y0 = e.clientY;
    });
    stage.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0;
      const dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) go(at + (dx < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => (tracking = false));
  });
</script>

<style>
  .tweets {
    max-width: 820px;
    margin: 0 auto;
    outline: none;
  }
  .tweets:focus-visible .stage {
    outline: 2px solid var(--paper);
    outline-offset: 6px;
  }

  /* Every slide shares one grid cell, so the stage is always as tall as the
     tallest tweet: no clipping, no jump between slides, no shift on load. */
  .stage {
    display: grid;
    touch-action: pan-y;
  }
  .tweet {
    --tw-ink: #0f1419;
    --tw-soft: #536471;
    --tw-line: #eff3f4;
    --tw-blue: #1d9bf0;
    --tw-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    grid-area: 1 / 1;
    visibility: hidden;
    background: #fff;
    color: var(--tw-ink);
    border-radius: 18px;
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.7);
    padding: clamp(18px, 3vw, 26px) clamp(18px, 4vw, 34px) clamp(14px, 2vw, 20px);
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-family: var(--tw-font);
  }
  .tweet.active {
    visibility: visible;
  }
  .enter-next {
    animation: in-next 0.45s var(--ease);
  }
  .enter-prev {
    animation: in-prev 0.45s var(--ease);
  }
  @keyframes in-next {
    from {
      opacity: 0;
      transform: translateX(28px);
    }
  }
  @keyframes in-prev {
    from {
      opacity: 0;
      transform: translateX(-28px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enter-next,
    .enter-prev {
      animation: none;
    }
  }

  /* Short tweets sit in the vertical middle of the shared frame. */
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .head :global(.avatar) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    flex: none;
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .name {
    font-weight: 700;
    font-size: 16px;
  }
  .handle {
    color: var(--tw-soft);
    font-size: 15px;
  }
  .text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--tw-ink);
    font-family: var(--tw-font);
    padding: 16px 0 4px;
  }
  .tag {
    color: var(--tw-blue);
  }
  .size-xl .text {
    font-size: clamp(24px, 3.2vw, 34px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .size-lg .text {
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.32;
  }
  .size-md .text {
    font-size: clamp(16px, 1.9vw, 20px);
    line-height: 1.4;
  }
  .byline {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--tw-line);
    font-size: 15px;
    color: var(--tw-soft);
  }

  .controls {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    margin-top: 26px;
  }
  .nav {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: var(--paper);
    font-family: var(--display);
    font-size: 20px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition:
      background 0.2s,
      border-color 0.2s;
  }
  .nav:hover {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .count {
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--paper);
    min-width: 4.5ch;
    font-variant-numeric: tabular-nums;
  }
  .bar {
    flex: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.18);
    position: relative;
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--paper);
    transition: width 0.35s var(--ease);
  }
</style>

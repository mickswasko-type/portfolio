---
import Gallery from './Gallery.astro';
import AwardBadge from './AwardBadge.astro';
import type { Project } from '../data/work';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const caseHref = p.caseStudy ? `${base}work/${p.caseStudy}/` : null;
---

<article class:list={['card', 'reveal', { wide: p.wide }]} id={p.id} data-kind={p.kind} data-wide={String(!!p.wide)}>
  <div class="viz">
    <Gallery slides={p.slides} stage={p.stage} width={p.wide ? 680 : 560} label={`${p.name} images`} />
  </div>
  <div class="body">
    <p class="tag">{p.tag}</p>
    {p.award && <div class="award-row"><AwardBadge {...p.award} /></div>}
    <h3 class="name">{caseHref ? <a href={caseHref}>{p.name}</a> : p.name}</h3>
    <p class="summary">{p.summary}</p>
    <div class="cred">
      <dl class="facts">
        {
          p.facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <span class="links">
        {
          caseHref && (
            <a class="case-link" href={caseHref}>
              Read the case study <span aria-hidden="true">→</span>
            </a>
          )
        }
        {
          p.link && (
            <a class="arrow-link" href={p.link.href} target="_blank" rel="noopener">
              {p.link.label} <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </span>
    </div>
  </div>
</article>

<style>
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition:
      box-shadow 0.35s var(--ease),
      transform 0.35s var(--ease),
      opacity 0.8s var(--ease);
  }
  .card:hover {
    box-shadow: 0 24px 50px -28px rgba(26, 22, 19, 0.45);
  }
  .viz {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
  }
  .body {
    padding: 22px 26px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .tag {
    font-family: var(--italic);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .name {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 27px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 10px 0 12px;
    text-wrap: balance;
  }
  .summary {
    font-size: 17px;
    line-height: 1.5;
    flex: 1;
  }
  .cred {
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px 16px;
  }
  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    font-size: 13.5px;
    line-height: 1.35;
  }
  .facts div {
    display: contents;
  }
  .facts dt {
    font-family: var(--italic);
    font-style: italic;
    color: var(--ink-soft);
  }
  .facts dd {
    font-family: var(--display);
    font-weight: 600;
    color: var(--ink);
  }
  .cred .arrow-link {
    font-size: 13px;
  }
  .links {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .name a {
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.35s var(--ease);
  }
  .name a:hover {
    background-size: 100% 2px;
  }
  .case-link {
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
    background: var(--ink);
    color: var(--paper);
    padding: 7px 12px;
    transition: background 0.2s;
  }
  .case-link:hover {
    background: #3a322b;
  }

  .card.wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
  }
  .card.wide .viz {
    aspect-ratio: auto;
    min-height: 380px;
    border-bottom: none;
    border-right: 1px solid var(--line);
  }
  .card.wide .body {
    justify-content: center;
    padding: 36px 40px;
  }
  .card.wide .name {
    font-size: clamp(26px, 3vw, 36px);
  }
  .card.wide .summary {
    flex: 0;
  }

  @media (max-width: 860px) {
    .card.wide {
      display: flex;
    }
    .card.wide .viz {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .card.wide .body {
      padding: 22px 26px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker: string;
  subtitle: string;
  dek: string;
  cover: ImageMetadata;
  coverAlt: string;
  meta: { k: string; v: string }[];
  /** 'tilt' for a printed report cover, 'flat' for a wide campaign image. */
  coverStyle?: 'tilt' | 'flat';
}

const { kicker, subtitle, dek, cover, coverAlt, meta, coverStyle = 'tilt' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="cs-head">
  <div class="wrap">
    <a class="back" href={`${base}#work`}>← All work</a>
    <div class:list={['hero', `cover-${coverStyle}`]}>
      <div class="hero-copy">
        <div class="kicker">{kicker}</div>
        <div class="head-rule"></div>
        <h1><slot /></h1>
        <p class="subtitle">{subtitle}</p>
        <p class="dek">{dek}</p>
      </div>
      <div class="cover" data-gallery>
        <button type="button" class="zoomable" data-full={cover.src} data-alt={coverAlt}>
          <Image
            src={cover}
            alt={coverAlt}
            widths={[360, 600, 900].filter((w) => w < cover.width).concat([cover.width])}
            sizes="(max-width: 760px) 80vw, 460px"
            format="webp"
            loading="eager"
          />
        </button>
      </div>
    </div>
    <dl class="meta" style={`--cols: ${meta.length}`}>
      {
        meta.map((m) => (
          <div>
            <dt>{m.k}</dt>
            <dd>{m.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</header>

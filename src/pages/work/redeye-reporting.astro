---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CaseHero from '../../components/CaseHero.astro';
import MoreWork from '../../components/MoreWork.astro';
import data from '../../data/redeye-clips.json';
import { apDate } from '../../lib/format';
import '../../styles/case-study.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/redeye/*.jpg', { eager: true });
const img = (name: string) => files[`../../assets/redeye/${name}.jpg`].default;

// Each cover opens its two-page spread, sized for reading up close in the lightbox.
const clips = await Promise.all(
  data.clips.map(async (c) => {
    const spread = img(`${c.slug}-spread`);
    const full = await getImage({ src: spread, width: Math.min(spread.width, 3000), format: 'webp', quality: 80 });
    return { ...c, cover: img(`${c.slug}-cover`), spreadFull: full.src };
  }),
);
const picks = clips.filter((c) => c.featured);
const rest = clips.filter((c) => !c.featured);
---

<Base
  title="Bylines"
  description="Cover stories Mick Swasko reported for RedEye, the Chicago Tribune's free daily, 2012–2015: Bitcoin, bar fights, Chicago's missing, Nik Wallenda and more."
  current="case-study"
>
  <CaseHero
    kicker="Journalism"
    subtitle="Fourteen front pages, 2012–2015."
    dek="Before the B2B content funnel, the job was getting a Chicago commuter to pick up the paper."
    cover={img('chasing-the-high-score-cover')}
    coverAlt="RedEye front page, April 15, 2014: Chasing the High Score"
    meta={[
      { k: 'Role', v: 'Staff reporter' },
      { k: 'Publication', v: 'RedEye (Chicago Tribune)' },
      { k: 'Run', v: '2012–2015' },
      { k: 'Clips', v: '14 cover stories' },
    ]}
  >
    Bylines
  </CaseHero>

  <section class="seed">
    <div class="wrap">
      <div class="label reveal">The beat</div>
      <p class="reveal">
        RedEye was the Chicago Tribune’s free daily for commuters, and every morning it had to earn its pickup. As a
        staff reporter, I pitched and wrote cover stories that did: data-driven explainers, trend pieces, profiles, and
        live coverage from the crowd.
      </p>
      <p class="reveal hint">Click any cover to open the story’s full spread. Click the spread again to zoom in and read.</p>
    </div>
  </section>

  <div data-gallery>
    <section class="clips-sec">
      <div class="wrap">
        <h2 class="label reveal">The picks</h2>
        <ul class="clips picks">
          {
            picks.map((c) => (
              <li class="clip reveal">
                <button type="button" class="cover-btn" data-full={c.spreadFull} data-alt={`${c.headline} — RedEye, ${apDate(c.date)}, pages ${c.pages.join('–')}`}>
                  <Image src={c.cover} alt={`RedEye front page, ${apDate(c.date)}`} widths={[300, 500, 800]} sizes="(max-width: 760px) 50vw, 270px" format="webp" />
                  <span class="open" aria-hidden="true">Read the spread</span>
                </button>
                <p class="meta-line">{c.label}, {apDate(c.date)}</p>
                <h3>{c.headline}</h3>
                {c.deck && <p class="deck">{c.deck}</p>}
                <p class="sum">{c.summary}</p>
                {c.note && <p class="note">{c.note}</p>}
                <a class="arrow-link" href={c.fullIssuePdf} target="_blank" rel="noopener">
                  Read the full issue <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="clips-sec more-clips">
      <div class="wrap">
        <h2 class="label reveal">More cover stories</h2>
        <ul class="clips">
          {
            rest.map((c) => (
              <li class="clip reveal">
                <button type="button" class="cover-btn" data-full={c.spreadFull} data-alt={`${c.headline} — RedEye, ${apDate(c.date)}, pages ${c.pages.join('–')}`}>
                  <Image src={c.cover} alt={`RedEye front page, ${apDate(c.date)}`} widths={[300, 500]} sizes="(max-width: 760px) 50vw, 220px" format="webp" />
                  <span class="open" aria-hidden="true">Read the spread</span>
                </button>
                <p class="meta-line">{c.label}, {apDate(c.date)}</p>
                <h3>{c.headline}</h3>
                {c.deck && <p class="deck">{c.deck}</p>}
                <p class="sum">{c.summary}</p>
                {c.note && <p class="note">{c.note}</p>}
                <a class="arrow-link" href={c.fullIssuePdf} target="_blank" rel="noopener">
                  Read the full issue <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <section class="takeaway">
    <div class="wrap">
      <div class="label reveal">The archive</div>
      <p class="big reveal">
        Every surviving RedEye front page from 2008 to 2016 now lives in The Red Paper Box, the archive I built so former
        colleagues could find their work again.
      </p>
      <p class="reveal ext">
        <a class="arrow-link" href="https://mickswasko-type.github.io/red-paper-box/" target="_blank" rel="noopener"
          >Visit the archive <span aria-hidden="true">↗</span></a
        >
        <a class="arrow-link" href={`${base}#red-paper-box`}>How I built it <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <MoreWork exclude="redeye-reporting" />
</Base>

<style>
  .hint {
    font-size: 15px !important;
    font-family: var(--italic);
    font-style: italic;
    color: var(--ink-soft);
  }
  .clips-sec {
    padding-top: 12px;
  }
  .more-clips {
    padding-top: 36px;
  }
  .clips {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px 24px;
  }
  .clips.picks {
    gap: 40px 28px;
  }
  .cover-btn {
    position: relative;
    display: block;
    width: 100%;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }
  .cover-btn :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    box-shadow: 0 18px 36px -22px rgba(26, 22, 19, 0.55);
    transition: transform 0.5s var(--ease);
  }
  .cover-btn:hover :global(img) {
    transform: translateY(-4px) rotate(-0.6deg);
  }
  .open {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 12px;
    background: var(--ink);
    color: var(--paper);
    padding: 6px 10px;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.25s,
      transform 0.25s var(--ease);
  }
  .cover-btn:hover .open,
  .cover-btn:focus-visible .open {
    opacity: 1;
    transform: none;
  }
  .meta-line {
    font-family: var(--italic);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-soft);
    margin: 16px 0 4px;
  }
  .clip h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .picks .clip h3 {
    font-size: 24px;
  }
  .deck {
    font-family: var(--italic);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.4;
    color: var(--ink-soft);
    margin-top: 6px;
  }
  .sum {
    font-size: 15.5px;
    line-height: 1.45;
    margin-top: 8px;
  }
  .note {
    font-family: var(--display);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    border-left: 2px solid var(--ink);
    padding: 2px 0 2px 8px;
    margin-top: 10px;
  }
  .clip .arrow-link {
    margin-top: 12px;
    font-size: 13px;
  }
  .ext {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  @media (max-width: 1000px) {
    .clips {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .clips.picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .clips,
    .clips.picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
    .clip h3,
    .picks .clip h3 {
      font-size: 18px;
    }
    .sum,
    .deck {
      font-size: 14.5px;
    }
  }
</style>

---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CaseHero from '../../components/CaseHero.astro';
import MoreWork from '../../components/MoreWork.astro';
import '../../styles/case-study.css';

import cover from '../../assets/work/speak-up-cover.jpg';
import spread from '../../assets/work/speak-up-spread.jpg';

const spreadFull = await getImage({ src: spread, format: 'webp' });

const editions = [
  {
    year: '2019',
    label: 'Baseline',
    title: 'Put a hard number on a soft assumption.',
    chips: [
      { b: '~1 in 4', t: 'speakers were women' },
      { t: 'The franchise is born', held: true },
    ],
    href: 'https://drive.google.com/file/d/1J-Nk_-A_ywSWhHonRS6vbGPf0_i7xj1i/view',
  },
  {
    year: '2020',
    label: 'Experience',
    title: 'From who’s on stage to how it feels to be there — then a live pivot into virtual events and the equity reckoning.',
    chips: [
      { b: '500', t: 'women surveyed, US & UK' },
      { t: 'Same name, new lens', held: true },
    ],
    href: 'https://drive.google.com/file/d/108ic4NgpNKUu48P2nkb3EF5n2F5qm7l1/view',
  },
  {
    year: '2022',
    label: 'Global',
    title: 'Three continents, and harder truths about who it’s toughest for.',
    chips: [
      { b: '1,500', t: 'women — US, UK & India' },
      { b: '44%', t: 'saw rising harassment' },
    ],
    href: 'https://www.ensono.com/resources/blog/speak-up-2022',
  },
  {
    year: '2024',
    label: 'Reckoning',
    title: 'Equity gains running straight into post-layoff economic pressure.',
    chips: [
      { b: '93%', t: 'saw equity gains' },
      { b: '73%', t: 'absorbed more work' },
    ],
    href: 'https://www.ensono.com/insights-and-news/expert-opinions/speak-up-2024-amplifying-womens-voices-in-our-transformative-tech-era/',
  },
  {
    year: '2025',
    label: 'Next',
    title: 'Onto return-to-office mandates and generative AI.',
    chips: [{ t: 'Ran after I left — and still itself', held: true }],
    href: 'https://www.ensono.com/wp-content/uploads/2025/03/Ensono-SpeakUp-V3-Final.pdf',
  },
];
---

<Base
  title="Ensono’s “Speak Up” — Case Study"
  description="How a single tweet became a five-edition research franchise on women in tech: 140+ pieces of earned coverage, WSJ, Forbes, Fast Company."
  current="case-study"
>
  <CaseHero
    kicker="Case study · Content strategy"
    subtitle="An impact engine in an evolving industry."
    dek="An idea that kept its shape, even when the world didn’t."
    cover={cover}
    coverAlt="Speak Up 2019 report cover"
    meta={[
      { k: 'Client', v: 'Ensono' },
      { k: 'Role', v: 'Content strategy, data collection, research & lead writer' },
      { k: 'Agency', v: 'Walker Sands' },
      { k: 'Run', v: '2019–2025' },
    ]}
  >
    Ensono’s <em>“Speak Up”</em>
  </CaseHero>

  <section class="seed">
    <div class="wrap">
      <div class="label reveal">How it started</div>
      <p class="reveal">
        In 2017, an Ensono leader noticed the women’s restroom at a 40,000-person tech conference sat empty and fired
        off a Tweet that started everything.
      </p>
      <p class="pullquote reveal">If women were missing from somewhere that ordinary, where else?</p>
    </div>
  </section>

  <section class="artifact">
    <div class="wrap">
      <div class="label reveal">The work</div>
      <p class="cap reveal">
        <b>The 2019 inaugural report:</b> an audit of 18 of the world’s biggest tech conferences, plus an original survey
        of the women in the room.
      </p>
      <button type="button" class="spread reveal" data-full={spreadFull.src} data-alt="Data spread from the 2019 report">
        <Image
          src={spread}
          alt="Data spread from the 2019 report"
          widths={[600, 900, spread.width]}
          sizes="(max-width: 1180px) 100vw, 1100px"
          format="webp"
        />
      </button>
    </div>
  </section>

  <section class="timeline-sec">
    <div class="wrap">
      <div class="label reveal">Impact over time</div>
      <h2 class="reveal">Watching the needle on tech equity.</h2>
      <ol class="timeline">
        {
          editions.map((e) => (
            <li class="edition reveal">
              <div class="ed-year">
                {e.year}
                <span>{e.label}</span>
              </div>
              <p class="ed-title">{e.title}</p>
              <div class="ed-row">
                {e.chips.map((c) => (
                  <span class:list={['chip', { held: c.held }]}>
                    {c.b && <b>{c.b}</b>} {c.t}
                  </span>
                ))}
                <a class="arrow-link" href={e.href} target="_blank" rel="noopener">
                  Read the {e.year} report <span aria-hidden="true">↗</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="discipline">
    <div class="wrap">
      <div class="label reveal">The discipline</div>
      <div class="split reveal">
        <div>
          <h3>Reinforced every year</h3>
          <ul>
            <li>The name and the mission</li>
            <li>Original research as the spine</li>
            <li>The brand voice and POV</li>
            <li>Data and thought leadership the press trusted</li>
          </ul>
        </div>
        <div>
          <h3>Moved with the moment</h3>
          <ul>
            <li>The lens — seats, experience, equity</li>
            <li>The scope — 500 to 1,500 voices</li>
            <li>The map — two countries to three</li>
            <li>The format and theme — whatever the year needed</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="results">
    <div class="wrap">
      <div class="label reveal">What it drove</div>
      <h2 class="reveal">Earned media and a growing brand footprint.</h2>
      <div class="stats">
        <div class="reveal"><span class="statnum">140+</span><span class="statlab">pieces of earned coverage across the run</span></div>
        <div class="reveal"><span class="statnum">80+</span><span class="statlab">placements from the 2019 launch alone</span></div>
        <div class="reveal"><span class="statnum">5</span><span class="statlab">editions · 3 continents</span></div>
      </div>
      <div class="placements reveal">
        <div class="pl-lab">Featured in</div>
        <p class="pl-list">
          The Wall Street Journal <span>/</span> Forbes <span>/</span> Entrepreneur <span>/</span> Fast Company
        </p>
      </div>
      <p class="note reveal">
        The brief was thought leadership: position a mainframe-and-cloud company as a credible voice on tech equity. The
        press it earned, edition after edition, is what made that real.
      </p>
      <p class="disclaimer">
        Coverage figures drawn from the Walker Sands case study and reflect the 2019–2022 editions; complete results
        not current.
      </p>
    </div>
  </section>

  <section class="takeaway">
    <div class="wrap">
      <div class="label reveal">Why it matters</div>
      <p class="big reveal">
        Women at Ensono told us the stories. Our partnership helped give them <em>the data and the platform</em> to tell it
        to the world with confidence.
      </p>
    </div>
  </section>

  <MoreWork />
</Base>


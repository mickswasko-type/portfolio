---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/work';

import cover from '../../assets/work/speak-up-cover.jpg';
import spread from '../../assets/work/speak-up-spread.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const spreadFull = await getImage({ src: spread, format: 'webp' });

const editions = [
  {
    year: '2019',
    label: 'Baseline',
    title: 'Put a hard number on a soft assumption.',
    chips: [
      { b: '~1 in 4', t: 'speakers were women' },
      { t: 'The franchise is born', held: true },
    ],
    href: 'https://drive.google.com/file/d/1J-Nk_-A_ywSWhHonRS6vbGPf0_i7xj1i/view',
  },
  {
    year: '2020',
    label: 'Experience',
    title: 'From who’s on stage to how it feels to be there — then a live pivot into virtual events and the equity reckoning.',
    chips: [
      { b: '500', t: 'women surveyed, US & UK' },
      { t: 'Same name, new lens', held: true },
    ],
    href: 'https://drive.google.com/file/d/108ic4NgpNKUu48P2nkb3EF5n2F5qm7l1/view',
  },
  {
    year: '2022',
    label: 'Global',
    title: 'Three continents, and harder truths about who it’s toughest for.',
    chips: [
      { b: '1,500', t: 'women — US, UK & India' },
      { b: '44%', t: 'saw rising harassment' },
    ],
    href: 'https://www.ensono.com/resources/blog/speak-up-2022',
  },
  {
    year: '2024',
    label: 'Reckoning',
    title: 'Equity gains running straight into post-layoff economic pressure.',
    chips: [
      { b: '93%', t: 'saw equity gains' },
      { b: '73%', t: 'absorbed more work' },
    ],
    href: 'https://www.ensono.com/insights-and-news/expert-opinions/speak-up-2024-amplifying-womens-voices-in-our-transformative-tech-era/',
  },
  {
    year: '2025',
    label: 'Next',
    title: 'Onto return-to-office mandates and generative AI.',
    chips: [{ t: 'Ran after I left — and still itself', held: true }],
    href: 'https://www.ensono.com/wp-content/uploads/2025/03/Ensono-SpeakUp-V3-Final.pdf',
  },
];

const next = projects.slice(0, 3);
---

<Base
  title="Ensono’s “Speak Up” — Case Study"
  description="How a single tweet became a five-edition research franchise on women in tech: 140+ pieces of earned coverage, WSJ, Forbes, Fast Company."
  current="case-study"
>
  <header class="cs-head">
    <div class="wrap">
      <a class="back" href={`${base}#work`}>← All work</a>
      <div class="hero">
        <div class="hero-copy">
          <div class="kicker">Case study · Content strategy</div>
          <div class="head-rule"></div>
          <h1>Ensono’s <em>“Speak Up”</em></h1>
          <p class="subtitle">An impact engine in an evolving industry.</p>
          <p class="dek">An idea that kept its shape, even when the world didn’t.</p>
        </div>
        <div class="cover" data-gallery>
          <button type="button" class="zoomable" data-full={cover.src} data-alt="Speak Up 2019 report cover">
            <Image
              src={cover}
              alt="Speak Up 2019 report cover"
              widths={[360, 600, 900]}
              sizes="(max-width: 760px) 80vw, 380px"
              format="webp"
              loading="eager"
            />
          </button>
        </div>
      </div>
      <dl class="meta">
        <div><dt>Client</dt><dd>Ensono</dd></div>
        <div><dt>Role</dt><dd>Content strategy, data collection, research &amp; lead writer</dd></div>
        <div><dt>Agency</dt><dd>Walker Sands</dd></div>
        <div><dt>Run</dt><dd>2019–2025</dd></div>
      </dl>
    </div>
  </header>

  <section class="seed">
    <div class="wrap">
      <div class="label reveal">How it started</div>
      <p class="reveal">
        In 2017, an Ensono leader noticed the women’s restroom at a 40,000-person tech conference sat empty and fired
        off a Tweet that started everything.
      </p>
      <p class="pullquote reveal">If women were missing from somewhere that ordinary, where else?</p>
    </div>
  </section>

  <section class="artifact">
    <div class="wrap">
      <div class="label reveal">The work</div>
      <p class="cap reveal">
        <b>The 2019 inaugural report:</b> an audit of 18 of the world’s biggest tech conferences, plus an original survey
        of the women in the room.
      </p>
      <button type="button" class="spread reveal" data-full={spreadFull.src} data-alt="Data spread from the 2019 report">
        <Image
          src={spread}
          alt="Data spread from the 2019 report"
          widths={[600, 900, spread.width]}
          sizes="(max-width: 1180px) 100vw, 1100px"
          format="webp"
        />
      </button>
    </div>
  </section>

  <section class="timeline-sec">
    <div class="wrap">
      <div class="label reveal">Impact over time</div>
      <h2 class="reveal">Watching the needle on tech equity.</h2>
      <ol class="timeline">
        {
          editions.map((e) => (
            <li class="edition reveal">
              <div class="ed-year">
                {e.year}
                <span>{e.label}</span>
              </div>
              <p class="ed-title">{e.title}</p>
              <div class="ed-row">
                {e.chips.map((c) => (
                  <span class:list={['chip', { held: c.held }]}>
                    {c.b && <b>{c.b}</b>} {c.t}
                  </span>
                ))}
                <a class="arrow-link" href={e.href} target="_blank" rel="noopener">
                  Read the {e.year} report <span aria-hidden="true">↗</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="discipline">
    <div class="wrap">
      <div class="label reveal">The discipline</div>
      <div class="split reveal">
        <div>
          <h3>Held every year</h3>
          <ul>
            <li>The name and the mission</li>
            <li>Original research as the spine</li>
            <li>The brand voice and POV</li>
            <li>Data and thought leadership the press trusted</li>
          </ul>
        </div>
        <div>
          <h3>Moved with the moment</h3>
          <ul>
            <li>The lens — seats, experience, equity</li>
            <li>The scope — 500 to 1,500 voices</li>
            <li>The map — two countries to three</li>
            <li>The format and theme — whatever the year needed</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="results">
    <div class="wrap">
      <div class="label reveal">What it drove</div>
      <h2 class="reveal">Earned media and a growing brand footprint.</h2>
      <div class="stats">
        <div class="reveal"><span class="statnum">140+</span><span class="statlab">pieces of earned coverage across the run</span></div>
        <div class="reveal"><span class="statnum">80+</span><span class="statlab">placements from the 2019 launch alone</span></div>
        <div class="reveal"><span class="statnum">5</span><span class="statlab">editions · 3 continents</span></div>
      </div>
      <div class="placements reveal">
        <div class="pl-lab">Featured in</div>
        <p class="pl-list">
          The Wall Street Journal <span>/</span> Forbes <span>/</span> Entrepreneur <span>/</span> Fast Company
        </p>
      </div>
      <p class="note reveal">
        The brief was thought leadership: position a mainframe-and-cloud company as a credible voice on tech equity. The
        press it earned, edition after edition, is what made that real.
      </p>
      <p class="disclaimer">
        Coverage figures drawn from the Walker Sands case study and reflect the 2019–2022 editions; they are not
        current.
      </p>
    </div>
  </section>

  <section class="takeaway">
    <div class="wrap">
      <div class="label reveal">Why it matters</div>
      <p class="big reveal">
        Women at Ensono told us the stories. Our partnership helped give them <em>the data and the platform</em> to tell it
        to the world with confidence.
      </p>
    </div>
  </section>

  <section class="more">
    <div class="wrap">
      <div class="more-head">
        <span class="label">More work</span>
        <a class="arrow-link" href={`${base}#work`}>See everything <span aria-hidden="true">→</span></a>
      </div>
      <ul class="more-list">
        {
          next.map((p) => (
            <li>
              <a href={`${base}#${p.id}`}>
                <span class="m-tag">{p.tag}</span>
                <span class="m-name">{p.name}</span>
                <span class="m-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .label {
    font-family: var(--display);
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(28px, 3.8vw, 42px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  /* Header */
  .cs-head {
    padding: 28px 0 40px;
  }
  .back {
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .back:hover {
    color: var(--accent);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    margin-top: clamp(28px, 5vw, 56px);
  }
  .hero-copy {
    animation: rise 0.8s var(--ease) both;
  }
  .head-rule {
    height: 3px;
    background: var(--ink);
    width: 60px;
    margin: 18px 0 24px;
  }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(48px, 7.6vw, 104px);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }
  h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .subtitle {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.2;
    max-width: 24ch;
    margin-bottom: 12px;
  }
  .dek {
    font-style: italic;
    font-size: 19px;
    color: var(--ink-soft);
    max-width: 34ch;
  }
  .cover {
    justify-self: center;
    max-width: 380px;
    animation: rise 0.8s 0.12s var(--ease) both;
  }
  .zoomable,
  .spread {
    display: block;
    border: 0;
    padding: 0;
    background: none;
    cursor: zoom-in;
  }
  .zoomable :global(img) {
    box-shadow: 0 26px 50px -22px rgba(26, 22, 19, 0.55);
    border: 1px solid var(--line);
    transform: rotate(2deg);
    transition: transform 0.6s var(--ease);
  }
  .zoomable:hover :global(img) {
    transform: rotate(0) scale(1.02);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .meta {
    margin-top: 44px;
    display: grid;
    grid-template-columns: 1fr 2fr 1fr 1fr;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .meta div {
    padding: 18px 22px 16px;
    border-left: 1px solid var(--line);
  }
  .meta div:first-child {
    padding-left: 0;
    border-left: none;
  }
  .meta dt {
    font-family: var(--display);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .meta dd {
    font-family: var(--display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
  }

  section {
    padding: 44px 0;
  }
  .seed p {
    font-size: 20px;
    max-width: 58ch;
    margin-bottom: 20px;
  }
  .pullquote {
    font-style: italic;
    font-size: clamp(28px, 4vw, 44px) !important;
    line-height: 1.18;
    letter-spacing: -0.01em;
    padding-left: 26px;
    border-left: 4px solid var(--accent);
    max-width: 22ch !important;
  }

  .artifact {
    background: var(--panel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 52px 0;
  }
  .cap {
    font-size: 18px;
    color: var(--ink-soft);
    max-width: 62ch;
    margin-bottom: 24px;
  }
  .cap b {
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
  }
  .spread :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 30px 60px -36px rgba(26, 22, 19, 0.5);
  }

  .timeline-sec {
    padding-top: 64px;
  }
  .timeline {
    list-style: none;
    position: relative;
    margin-top: 28px;
  }
  /* Each edition draws the spine down to the next dot, so it ends at the last one. */
  .edition:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 20px;
    bottom: -12px;
    width: 2px;
    background: var(--accent);
  }
  .edition {
    position: relative;
    padding: 0 0 40px 48px;
  }
  .edition::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--accent);
    z-index: 1;
  }
  .ed-year {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(32px, 4.4vw, 46px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .ed-year span {
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
    margin-left: 12px;
    vertical-align: middle;
  }
  .ed-title {
    font-size: 19px;
    margin: 10px 0 14px;
    max-width: 50ch;
  }
  .ed-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .chip {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 8px 14px;
    font-size: 15.5px;
    line-height: 1.35;
  }
  .chip b {
    font-family: var(--display);
    font-weight: 800;
  }
  .chip.held {
    border-color: #e3c9c0;
    background: #f7ece8;
    color: var(--accent-deep);
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 2px solid var(--ink);
  }
  .split > div {
    padding: 26px 28px;
  }
  .split > div:first-child {
    border-right: 2px solid var(--ink);
  }
  .split h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .split > div:first-child h3 {
    color: var(--accent);
  }
  .split ul {
    list-style: none;
  }
  .split li {
    font-size: 17px;
    line-height: 1.4;
    padding: 9px 0;
    border-bottom: 1px dotted var(--line);
  }
  .split li:last-child {
    border-bottom: none;
  }

  .results {
    background: var(--ink);
    color: var(--paper);
    padding: 64px 0;
    margin-top: 20px;
  }
  .results .label,
  .pl-lab {
    color: #e8a38f;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 900px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    margin: 28px 0;
  }
  .stats div {
    padding: 24px 18px 24px 0;
  }
  .statnum {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(40px, 5.6vw, 64px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--accent-soft);
  }
  .statlab {
    display: block;
    font-size: 15.5px;
    line-height: 1.35;
    margin-top: 8px;
    opacity: 0.85;
    max-width: 22ch;
  }
  .pl-lab {
    font-family: var(--display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .pl-list {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(22px, 3.2vw, 34px);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .pl-list span {
    color: var(--accent);
    font-weight: 400;
    padding: 0 6px;
  }
  .note {
    font-size: 18px;
    opacity: 0.9;
    max-width: 60ch;
    margin-top: 24px;
  }
  .disclaimer {
    font-size: 12px;
    font-style: italic;
    opacity: 0.5;
    margin-top: 22px;
    max-width: 64ch;
  }

  .takeaway {
    padding: 72px 0 56px;
  }
  .takeaway .big {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }
  .takeaway .big em {
    font-style: normal;
    color: var(--accent);
  }

  .more {
    padding: 0 0 72px;
  }
  .more-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 3px solid var(--ink);
    padding-top: 16px;
  }
  .more-list {
    list-style: none;
  }
  .more-list a {
    display: grid;
    grid-template-columns: 260px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: padding 0.3s var(--ease);
  }
  .more-list a:hover {
    padding-left: 12px;
  }
  .m-tag {
    font-family: var(--display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .m-name {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 28px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .m-go {
    font-family: var(--display);
    font-size: 22px;
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .cover {
      max-width: 240px;
    }
    .meta {
      grid-template-columns: 1fr 1fr;
    }
    .meta div {
      padding: 14px 16px 12px 0;
      border-left: none;
      border-bottom: 1px solid var(--line);
    }
    .meta div:nth-child(2) {
      grid-row: 2;
      grid-column: 1 / -1;
    }
    .split {
      grid-template-columns: 1fr;
    }
    .split > div:first-child {
      border-right: none;
      border-bottom: 2px solid var(--ink);
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .more-list a {
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }
    .m-tag {
      grid-column: 1 / -1;
    }
  }
</style>

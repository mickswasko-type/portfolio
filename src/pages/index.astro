---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TweetCarousel from '../components/TweetCarousel.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Swoop from '../components/Swoop.astro';
import { projects } from '../data/work';
import { career, capabilities, homeIndustries } from '../data/career';
import { siteConfig } from '../../site.config';

import speakUpCover from '../assets/work/speak-up-cover.jpg';
import dangerousFoods from '../assets/work/dangerous-foods-2.jpg';
import redeye from '../assets/work/redeye-1.png';
import kaiser from '../assets/work/kaiser-1.jpg';
import headshot from '../assets/headshot.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const kinds = [...new Set(projects.map((p) => p.kind))];

const principles = [
  {
    n: '01',
    head: 'Start with an open ear.',
    body: 'Good content starts with curiosity and empathy. Before the messaging framework or the campaign, I listen for what the audience actually needs — which isn’t always what the brief asked for. I live for “optional” thought leadership calls.',
  },
  {
    n: '02',
    head: 'Get it right.',
    body: 'Reporter’s instincts, managing editor’s eye. Clinical claims, survey data, and regulated copy get checked like they’re running on the front page tomorrow. Claude sneaks nothing by me.',
  },
  {
    n: '03',
    head: 'Make it move something.',
    body: 'Content is tied to buyer journeys, pipeline, and brand authority — mapped by buying stage, built for the whole committee, and measured against goals. TL;DR: Did it work?',
  },
  {
    n: '04',
    head: 'Let tech do the heavy lifting.',
    body: 'I’ve leaned into tech my whole career, from building data stories in Google Fusion Tables as a RedEye reporter to leading the push to put generative AI into production content work, the right way, from the start. The tools chew through the spec; I spend the saved hours on what matters — voice, depth, and making it fun.',
  },
];
---

<Base>
  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="rise" style="--d: 0.04s">Make it make <Swoop>sense</Swoop><span class="stop">.</span></h1>
        <p class="lede rise" style="--d: 0.16s">
          I’m Mick Swasko, a former Chicago Tribune and RedEye reporter who
          dove into the B2B content funnel. For nearly two decades I’ve turned original reporting, clinical research,
          enterprise tech, and hard data into stories people actually read.
        </p>
        <div class="cta rise" style="--d: 0.24s">
          <a class="btn solid" href="#work">See the work <span aria-hidden="true">↓</span></a>
          <a class="btn ghost" href="#contact">Get in touch</a>
        </div>
      </div>

      <a class="collage rise" style="--d: 0.2s" href="#work" aria-label="Jump to selected work">
        <figure class="c c1">
          <Image src={speakUpCover} alt="" widths={[300, 520]} sizes="260px" format="webp" loading="eager" />
        </figure>
        <figure class="c c2">
          <Image src={dangerousFoods} alt="" widths={[320, 600]} sizes="300px" format="webp" loading="eager" />
        </figure>
        <figure class="c c3">
          <Image src={redeye} alt="" widths={[400, 800]} sizes="380px" format="webp" loading="eager" />
        </figure>
        <figure class="c c4">
          <Image src={kaiser} alt="" widths={[360, 700]} sizes="340px" format="webp" loading="eager" />
        </figure>
      </a>
    </div>

    <div class="wrap">
      <div class="ledger rise" style="--d: 0.32s">
        <div class="ledger-label">From newsroom to boardroom</div>
        <ul>
          <li>Chicago Tribune</li>
          <li>RedEye</li>
          <li>Shedd Aquarium</li>
          <li>1871</li>
          <li>Walker Sands</li>
          <li>Park &amp; Battery</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ========== WORK ========== -->
  <section class="work" id="work">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">Selected work</div>
        <div>
          <h2>Bold ideas and big swings.</h2>
        </div>
        <p class="aside">Deliverables against the odds — for healthcare systems, B2B tech brands, and folks I like.</p>
      </div>

      <!-- Lead story -->
      <article class="lead reveal" id="speak-up">
        <a class="lead-img" href={`${base}work/speak-up/`} tabindex="-1" aria-hidden="true">
          <Image src={speakUpCover} alt="" widths={[400, 700, 1000]} sizes="(max-width: 860px) 100vw, 420px" format="webp" />
        </a>
        <div class="lead-body on-ink">
          <p class="lead-kicker">Case study: Ensono, with Walker Sands, 2019–2025</p>
          <h3><a href={`${base}work/speak-up/`}>Ensono’s “Speak Up”</a></h3>
          <p class="lead-dek">
            One tweet about an empty women’s restroom at a tech conference became a five-edition research franchise on
            women in tech — and a thought-leadership engine the press sought out for commentary.
          </p>
          <dl class="lead-stats">
            <div><dt>140+</dt><dd>pieces of earned coverage</dd></div>
            <div><dt>5</dt><dd>editions, three continents</dd></div>
            <div><dt>1,500</dt><dd>women surveyed at its peak</dd></div>
          </dl>
          <p class="lead-pubs">
            The Wall Street Journal <span>/</span> Forbes <span>/</span> Entrepreneur <span>/</span> Fast Company
          </p>
          <a class="btn solid light" href={`${base}work/speak-up/`}>Read the case study <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <div class="filters reveal" role="group" aria-label="Filter work">
        <button type="button" data-filter="all" aria-pressed="true">All work</button>
        {kinds.map((k) => <button type="button" data-filter={k} aria-pressed="false">{k}</button>)}
      </div>

      <div class="grid" data-grid>
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- ========== LOGOS ========== -->
  <section class="logos-sec" aria-labelledby="logos-head">
    <div class="wrap">
      <div class="kicker logos-flag reveal">The obligatory logo scroll</div>
    </div>
    <div class="wrap logos-head reveal">
      <h2 id="logos-head">I love the B2B scroll‑y logo thing. <span class="line">Here’s my scroll‑y logo thing.</span></h2>
    </div>
    <div class="reveal">
      <LogoStrip />
    </div>
  </section>

  <!-- ========== TWEETS ========== -->
  <section class="tweets-sec on-ink" id="tweets">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">Off the clock</div>
        <div>
          <h2>Funny when Twitter <Swoop>was</Swoop> fun.</h2>
        </div>
        <p class="aside">A few favorites from fourteen years of tweeting as @swasko.</p>
      </div>
      <div class="reveal">
        <TweetCarousel />
      </div>
    </div>
  </section>

  <!-- ========== ABOUT ========== -->
  <section class="about" id="about">
    <div class="wrap">
      <div class="kicker about-flag reveal">About</div>
    </div>
    <div class="wrap about-grid">
      <figure class="portrait reveal">
        <Image src={headshot} alt="Mick Swasko" widths={[360, 560, 840]} sizes="(max-width: 860px) 70vw, 380px" format="webp" />
      </figure>
      <div class="about-copy reveal">
        <h2>Reporter by training. Strategist by trade. <Swoop>Writer</Swoop> by instinct.</h2>
        <p>
          Storied newspapers. Historic aquariums. Startup incubators. Regulated healthcare systems. Growing B2B brands. In a
          career spent where journalism meets marketing, the assignments have varied wildly. The through-line hasn’t.
          Whether it’s a front-page byline, a clinical white paper, or a product launch, good content starts with an open
          ear and depends on curiosity, empathy, and the discipline to get it right.
        </p>
        <p>
          I bring a reporter’s intuition, a managing editor’s eye, and the strategic fluency to tie content to buyer
          journeys, business goals, and brand authority. I’ve embraced AI since its infancy — I use it where it’s
          useful, and have worked with it long enough to know where it isn’t.
        </p>
        <div class="about-links">
          <a class="btn solid" href={`${base}${siteConfig.resumePdf}`} target="_blank" rel="noopener">
            Résumé (PDF) <span aria-hidden="true">↓</span>
          </a>
          <a class="btn ghost" href={`${base}resume/`}>Read it online</a>
          <a class="arrow-link" href={siteConfig.linkedin} target="_blank" rel="noopener">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== APPROACH ========== -->
  <section class="approach" id="approach">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">Approach</div>
        <div>
          <h2>Bringing a reporter’s intuition to every project.</h2>
        </div>
        <p class="aside">Four rules I’ve carried from the newsroom into every assignment since.</p>
      </div>
      <ol class="principles">
        {
          principles.map((p) => (
            <li class="reveal">
              <span class="pn">{p.n}</span>
              <h3>{p.head}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="caps">
        {
          capabilities.map((c) => (
            <div class="cap reveal">
              <h3>{c.head}</h3>
              <ul>
                {c.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="industries reveal">
        <span class="ind-label">Industry expertise</span>
        <ul>{homeIndustries.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- ========== EXPERIENCE ========== -->
  <section class="experience" id="experience">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">Experience</div>
        <div>
          <h2>From newsroom to boardroom.</h2>
        </div>
        <p class="aside">Illinois State University — B.S. Journalism, minor in Political Science.</p>
      </div>

      <ol class="roles">
        {
          career.map((r) => (
            <li class="role reveal">
              <div class="r-years">{r.years}</div>
              <div class="r-main">
                <h3>
                  {r.org}
                  <span class="r-title">{r.title}</span>
                </h3>
                <p class="r-sum">{r.summary}</p>
                {r.points.length > 0 && (
                  <ul class="r-points">
                    {r.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div class="r-dates">{r.dates}</div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========== CONTACT ========== -->
  <section class="contact on-ink" id="contact">
    <div class="wrap">
      <div class="kicker contact-flag reveal">Contact</div>
    </div>
    <div class="wrap contact-grid">
      <div class="reveal">
        <h2>At a loss for words? Let’s&nbsp;chat.</h2>
      </div>
      <div class="contact-side reveal">
        <p>
          I’m open to content strategy, copywriting, and editorial leadership roles. Consulting too. Full case studies
          and more samples are available on request.
        </p>
        <a class="mail" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <span aria-hidden="true">→</span></a>
        <div class="contact-links">
          <a class="arrow-link" href={siteConfig.linkedin} target="_blank" rel="noopener">
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
          <a class="arrow-link" href={`${base}${siteConfig.resumePdf}`} target="_blank" rel="noopener">
            Résumé (PDF) <span aria-hidden="true">↓</span>
          </a>
        </div>
        <span class="loc">Based in {siteConfig.location}, in the Chicago area.</span>
      </div>
    </div>
  </section>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      grid.querySelectorAll<HTMLElement>('.card').forEach((c) => {
        const show = f === 'all' || c.dataset.kind === f;
        c.hidden = !show;
        // Filtered views are short, so every card gets the side-by-side layout.
        c.classList.toggle('wide', c.dataset.wide === 'true' || f !== 'all');
      });
    }),
  );
</script>

<style>
  /* ---------- Hero ---------- */
  h1 .stop {
    color: var(--accent);
  }
  h1 :global(.swoop path) {
    stroke-width: clamp(5px, 0.75vw, 10px);
  }
  .hero {
    padding: clamp(40px, 7vw, 88px) 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(52px, 9vw, 118px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin: 20px 0 26px;
  }
  /* "sense" gets a hand-drawn red stroke that writes itself in on load. */
  .lede {
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.45;
    max-width: 38ch;
    color: var(--ink);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .rise {
    opacity: 0;
    transform: translateY(16px);
    animation: rise 0.9s var(--ease) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .collage {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.02;
    width: 100%;
    max-width: 520px;
    justify-self: end;
  }
  .c {
    position: absolute;
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 22px 44px -22px rgba(26, 22, 19, 0.55);
    overflow: hidden;
    transition: transform 0.6s var(--ease);
  }
  .c :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c1 {
    width: 48%;
    aspect-ratio: 1224 / 1584;
    left: 2%;
    top: 4%;
    transform: rotate(-5deg);
    z-index: 2;
  }
  .c2 {
    width: 52%;
    aspect-ratio: 1;
    right: 0;
    top: 0;
    transform: rotate(4deg);
    z-index: 1;
  }
  .c3 {
    width: 66%;
    aspect-ratio: 1718 / 670;
    right: 0;
    bottom: 26%;
    transform: rotate(-2deg);
    z-index: 3;
  }
  .c4 {
    width: 56%;
    aspect-ratio: 972 / 572;
    left: 8%;
    bottom: 0;
    transform: rotate(3deg);
    z-index: 4;
  }
  .collage:hover .c1 {
    transform: rotate(-8deg) translate(-8px, -6px);
  }
  .collage:hover .c2 {
    transform: rotate(7deg) translate(8px, -8px);
  }
  .collage:hover .c3 {
    transform: rotate(-1deg) translate(10px, 4px);
  }
  .collage:hover .c4 {
    transform: rotate(5deg) translate(-8px, 8px);
  }

  .ledger {
    margin-top: clamp(48px, 7vw, 84px);
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding: 14px 0 16px;
  }
  .ledger-label {
    font-family: var(--italic);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .ledger ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
  }
  .ledger li {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(16px, 1.9vw, 22px);
    letter-spacing: -0.015em;
  }

  /* ---------- Work ---------- */
  .work {
    padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 104px);
  }
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    background: var(--ink);
    color: var(--paper);
    margin-bottom: 40px;
    overflow: hidden;
  }
  .lead-img {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #2a2420;
    padding: clamp(28px, 4vw, 56px);
    overflow: hidden;
  }
  .lead-img :global(img) {
    width: 100%;
    max-width: 360px;
    height: auto;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    transform: rotate(-2deg);
    transition: transform 0.7s var(--ease);
  }
  .lead:hover .lead-img :global(img) {
    transform: rotate(0deg) scale(1.02);
  }
  .lead-body {
    padding: clamp(28px, 4.5vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .lead-kicker {
    font-family: var(--italic);
    font-style: italic;
    font-size: 17px;
    color: rgba(234, 231, 222, 0.8);
  }
  .lead h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(40px, 4.6vw, 62px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    margin: 16px 0 16px;
  }
  .lead h3 a {
    text-decoration: none;
  }
  .lead-dek {
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.45;
    opacity: 0.92;
    max-width: 44ch;
  }
  .lead-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 28px 0 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .lead-stats div {
    padding: 16px 12px 16px 0;
  }
  .lead-stats dt {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1;
    color: var(--paper);
    letter-spacing: -0.02em;
  }
  .lead-stats dd {
    font-size: 14.5px;
    line-height: 1.3;
    margin-top: 6px;
    opacity: 0.8;
  }
  .lead-pubs {
    font-family: var(--display);
    font-weight: 700;
    font-size: 15px;
    margin-bottom: 26px;
  }
  .lead-pubs span {
    color: rgba(234, 231, 222, 0.45);
    padding: 0 4px;
    font-weight: 400;
  }
  .btn.light {
    align-self: flex-start;
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .btn.light:hover {
    background: transparent;
    border-color: var(--paper);
    color: var(--paper);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .filters button {
    font-family: var(--display);
    font-weight: 700;
    font-size: 13px;
    padding: 8px 14px;
    border: 1.5px solid var(--ink);
    background: transparent;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .filters button:hover {
    background: var(--panel);
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* ---------- Logos ---------- */
  .logos-sec {
    padding: clamp(56px, 7vw, 88px) 0 clamp(72px, 9vw, 112px);
    border-top: 1px solid var(--line);
  }
  .logos-flag {
    text-align: center;
  }
  .logos-head {
    text-align: center;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .logos-head h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(26px, 3.4vw, 42px);
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin: 12px auto 0;
    text-wrap: balance;
  }
  .logos-head h2 .line {
    display: block;
    color: var(--ink-soft);
  }
  .logos-sec :global(.strip) {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* ---------- Tweets ---------- */
  .tweets-sec {
    background: var(--ink);
    color: var(--paper);
    overflow-x: clip; /* the slide-in nudge must never widen the page */
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .tweets-sec .kicker {
    color: var(--paper);
  }
  .tweets-sec .aside {
    color: rgba(234, 231, 222, 0.7);
  }

  /* ---------- About ---------- */
  .about {
    padding: clamp(56px, 8vw, 104px) 0;
    border-top: 1px solid var(--line);
  }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
  }
  .portrait {
    position: relative;
    max-width: 400px;
    border: 2px solid var(--ink);
    box-shadow: 16px 16px 0 var(--ink);
    background: var(--panel);
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
  }
  .about-copy h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 12px 0 22px;
  }
  .about-copy p {
    font-size: 18.5px;
    line-height: 1.55;
    max-width: 58ch;
    margin-bottom: 16px;
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 26px;
  }

  /* ---------- Approach ---------- */
  .approach {
    background: var(--panel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .principles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-bottom: 1px solid var(--line);
    padding-bottom: 40px;
  }
  .principles li {
    padding: 0 24px;
    border-left: 1px solid var(--line);
  }
  .principles li:first-child {
    padding-left: 0;
    border-left: none;
  }
  .pn {
    font-family: var(--display);

---
import Base from '../layouts/Base.astro';
import { career, coreSkills, industries, summary } from '../data/career';
import { siteConfig } from '../../site.config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const portfolio = new URL(base, siteConfig.site).href;
const short = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base
  title="Résumé"
  description="Résumé of Mick Swasko: content strategy, editorial direction, and AI-augmented content for healthcare and B2B tech."
  current="case-study"
>
  <div class="wrap page">
    <div class="toolbar">
      <a class="back" href={base}>← Portfolio</a>
      <a class="btn solid" href={`${base}${siteConfig.resumePdf}`} target="_blank" rel="noopener">
        Download PDF <span aria-hidden="true">↓</span>
      </a>
    </div>

    <article class="sheet">
      <header class="r-head">
        <h1>Mick Swasko</h1>
        <p class="tagline">
          AI-Fluent Content Strategy &amp; Storytelling <span>·</span> From Newsroom to Boardroom <span>·</span> Complex Topics Made
          Human
        </p>
        <p class="contact">
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          <span>·</span>
          <a href={siteConfig.linkedin}>{short(siteConfig.linkedin)}</a>
          <span>·</span>
          <a href={portfolio}>{short(portfolio)}</a>
          <span>·</span>
          {siteConfig.location}
        </p>
      </header>

      <section>
        <h2>Summary</h2>
        <p class="summary">{summary}</p>
      </section>

      <section>
        <h2>Experience</h2>
        {
          career.map((r) => (
            <div class="job">
              <div class="job-head">
                <h3>
                  {r.org} <span class="sep">·</span> <span class="title">{r.title}</span>
                </h3>
                <span class="dates">{r.dates}</span>
              </div>
              <ul>
                {r.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section>
        <h2>Skills &amp; Expertise</h2>
        <p class="list">
          <b>Core skills:</b>
          {coreSkills.map((x, i) => <span class="it">{x}{i < coreSkills.length - 1 && <span class="dot"> ·</span>}</span>)}
        </p>
        <p class="list">
          <b>Industry experience:</b>
          {industries.map((x, i) => <span class="it">{x}{i < industries.length - 1 && <span class="dot"> ·</span>}</span>)}
        </p>
      </section>

      <section>
        <h2>Education</h2>
        <div class="job-head">
          <h3>
            Illinois State University <span class="sep">·</span>
            <span class="title">Bachelor of Science, Journalism · Minor in Political Science</span>
          </h3>
          <span class="dates">2004–2008</span>
        </div>
      </section>
    </article>
  </div>
</Base>

<style>
  .page {
    padding-top: 28px;
    padding-bottom: 72px;
  }
  .toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }
  .back {
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .back:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }

  .sheet {
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -40px rgba(26, 22, 19, 0.5);
    max-width: 8.5in;
    margin: 0 auto;
    padding: 0.6in 0.65in;
    color: var(--ink);
  }
  .r-head {
    border-bottom: 3px solid var(--ink);
    padding-bottom: 12px;
    margin-bottom: 4px;
  }
  h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .tagline {
    font-family: var(--display);
    font-weight: 600;
    font-size: 12.5px;
    color: var(--ink-soft);
    margin-top: 8px;
  }
  .tagline span,
  .contact span {
    color: var(--line);
    padding: 0 4px;
  }
  .contact {
    font-family: var(--display);
    font-size: 12px;
    color: var(--ink-soft);
    margin-top: 6px;
  }
  .contact a {
    color: var(--ink);
    text-decoration: none;
  }
  section {
    margin-top: 16px;
  }
  h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 4px;
    margin-bottom: 8px;
  }
  .summary {
    font-size: 13.5px;
    line-height: 1.5;
  }
  .job {
    margin-bottom: 10px;
  }
  .job-head {
    break-after: avoid;
  }
  li {
    break-inside: avoid;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.01em;
  }
  .sep {
    color: var(--ink-soft);
    padding: 0 2px;
  }
  .title {
    font-weight: 600;
    color: var(--ink-soft);
  }
  .dates {
    font-family: var(--display);
    font-weight: 600;
    font-size: 11.5px;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  ul {
    list-style: none;
    margin-top: 4px;
  }
  li {
    font-size: 12.5px;
    line-height: 1.42;
    padding: 1.5px 0 1.5px 14px;
    position: relative;
  }
  li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 9px;
    width: 6px;
    height: 1.5px;
    background: var(--ink-soft);
  }
  .list {
    font-size: 12.5px;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  .it {
    white-space: nowrap;
  }
  .it + .it::before {
    content: ' ';
    white-space: normal;
  }
  .dot {
    color: var(--ink-soft);
  }
  .list b {
    font-family: var(--display);
    font-weight: 700;
  }

  @media (max-width: 720px) {
    .sheet {
      padding: 28px 20px;
    }
    .job-head {
      flex-direction: column;
      gap: 2px;
    }
  }

  @media print {
    @page {
      size: letter;
      margin: 0.5in 0.55in;
    }
    .page {
      padding: 0;
      max-width: none;
    }
    .toolbar {
      display: none;
    }
    .sheet {
      border: none;
      box-shadow: none;
      padding: 0;
      max-width: none;
    }
  }
</style>

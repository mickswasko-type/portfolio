---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Rotator from '../../components/local/Rotator.astro';
import LocalForm from '../../components/local/LocalForm.astro';
import { services, steps, faq, testimonials } from '../../data/local';
import { siteConfig } from '../../../site.config';
import headshot from '../../assets/headshot-halftone.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { launched, slidesUrl } = siteConfig.local;
const description =
  'Marketing and writing help for businesses in Lombard, Glen Ellyn, and Villa Park, from a neighbor and former Chicago Tribune journalist.';
const subhead =
  'Marketing and writing help for businesses in Lombard, Glen Ellyn, and Villa Park, from a neighbor and former Chicago Tribune journalist. AI where it helps, a human where it counts.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Mick Swasko: marketing and writing for local businesses',
  description,
  url: new URL(`${base}local/`, Astro.site).href,
  image: new URL(`${base}local/og.png`, Astro.site).href,
  areaServed: ['Lombard', 'Glen Ellyn', 'Villa Park'].map((name) => ({
    '@type': 'City',
    name,
    containedInPlace: { '@type': 'State', name: 'Illinois' },
  })),
};
---

<Base
  title="Local marketing and writing help"
  description={description}
  variant="local"
  noindex={!launched}
  ogPath="local/og.png"
  ogAlt="Neighborhood flyers that make you happy. Mick Swasko, marketing and writing for Lombard, Glen Ellyn and Villa Park."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- ========== HERO ========== -->
  <section class="hero">
    <div class="wrap" data-rot-scope>
      <Rotator flag="For local businesses" />
      <p class="lede rise" style="--d: 0.16s">{subhead}</p>
      <div class="cta rise" style="--d: 0.24s">
        <a class="btn solid" href="#contact">Tell me what you’re working on</a>
        <a class="btn ghost" href={`${base}local/slop-test/`}>Get the Slop Test</a>
      </div>
      <div class="ledger rise" style="--d: 0.32s">
        <div class="ledger-label">Serving</div>
        <ul>
          <li>Lombard</li>
          <li>Glen Ellyn</li>
          <li>Villa Park</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ========== LIBRARY STRIP ========== -->
  <aside class="strip" aria-label="From the library talk">
    <div class="wrap strip-in">
      <p>
        <strong>Were you at the Helen Plum program?</strong>
        Here’s the one-page Slop Test{slidesUrl ? ' and the slides' : ''}.
      </p>
      <span class="strip-links">
        <a class="arrow-link" href={`${base}local/slop-test/`}>Get the Slop Test <span aria-hidden="true">→</span></a>
        {
          slidesUrl && (
            <a class="arrow-link" href={slidesUrl} target="_blank" rel="noopener">
              See the slides <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </span>
    </div>
  </aside>

  <!-- ========== SERVICES ========== -->
  <section class="services" id="services">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">What I do</div>
        <div>
          <h2>Pick the help you need.</h2>
        </div>
        <p class="aside">Three ways to work together. Every one starts with a conversation.</p>
      </div>
      <ul class="cards">
        {
          services.map((s) => (
            <li class:list={['card', 'reveal', { lead: s.lead }]}>
              <p class="tag">{s.lead ? 'Start here' : (s.tag ?? '')}</p>
              <h3>{s.title}</h3>
              <p class="blurb">{s.blurb}</p>
              {s.includes && (
                <p class="includes">
                  <span class="k">Includes</span> {s.includes}
                </p>
              )}
              <p class="good">
                <span class="k">Good for</span> {s.goodFor}
              </p>
              <p class="price">{s.price}</p>
              <a class="btn pick" href="#contact">
                Tell me what you’re working on
              </a>
            </li>
          ))
        }
      </ul>
      <p class="foot-note reveal">Prices are starting points. Every project gets a clear written quote before we begin.</p>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="how on-ink" id="how">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">How it works</div>
        <div>
          <h2>Three steps, no mystery.</h2>
        </div>
      </div>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step reveal">
              <span class="n" aria-hidden="true">{s.n}</span>
              <h3>{s.head}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========== WHY ME ========== -->
  <section class="why" id="why">
    <div class="wrap">
      <div class="why-grid">
        <figure class="portrait reveal">
          <Image src={headshot} alt="Halftone portrait of Mick Swasko" widths={[360, 560]} sizes="(max-width: 760px) 70vw, 360px" format="webp" quality={82} />
        </figure>
        <div class="why-copy">
          <div class="kicker reveal">Why work with me</div>
          <h2 class="reveal">Checked like it’s running on the front page.</h2>
          <ul class="facts reveal">
            <li>Former Chicago Tribune journalist, with nearly two decades in content and marketing.</li>
            <li>A neighbor, so you can reach me without a call center, a ticket number, or a contract longer than the project.</li>
          </ul>
          <p class="approach reveal">
            I use AI the way a good editor uses a first draft: it gets me to options fast. Then a person, me, checks
            every fact, price, and number before anything goes out. If I can’t verify it, it doesn’t ship.
          </p>
        </div>
      </div>
      {
        testimonials.length > 0 && (
          <div class="quotes">
            {testimonials.map((t) => (
              <figure class="quote reveal">
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  {t.name}
                  {t.business ? `, ${t.business}` : ''}
                </figcaption>
              </figure>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="faq" id="faq">
    <div class="wrap">
      <div class="section-head reveal">
        <div class="kicker">Questions</div>
        <div>
          <h2>Good questions.</h2>
        </div>
      </div>
      <div class="qa reveal">
        {
          faq.map((f) => (
            <details>
              <summary>
                <span>{f.q}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== CONTACT ========== -->
  <section class="contact on-ink" id="contact">
    <div class="wrap">
      <div class="kicker contact-flag">Contact</div>
      <div class="contact-grid">
        <div class="contact-copy reveal">
          <h2>Tell me what you’re working on.</h2>
          <p>A free 20-minute conversation is the first step. Tell me a little here and I’ll reply by email.</p>
        </div>
        <div class="form-card reveal">
          <LocalForm />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .rise {
    opacity: 0;
    transform: translateY(14px);
    animation: rise 0.8s var(--ease) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    padding: clamp(36px, 6vw, 80px) 0 clamp(36px, 5vw, 64px);
  }
  .lede {
    font-size: clamp(19px, 1.9vw, 23px);
    line-height: 1.45;
    max-width: 44ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .cta .btn {
    min-height: 52px;
  }
  .ledger {
    margin-top: clamp(40px, 6vw, 72px);
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    display: grid;
    gap: 8px;
    padding: 14px 0 16px;
  }
  .ledger-label {
    font-family: var(--italic);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft);
  }
  .ledger ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
  }
  .ledger li {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 26px);
    letter-spacing: -0.015em;
  }

  /* ---------- Library strip ---------- */
  .strip {
    background: var(--panel);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .strip-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 28px;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .strip p {
    font-size: 18px;
    line-height: 1.4;
    max-width: 62ch;
  }
  .strip strong {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .strip-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .strip .arrow-link {
    min-height: 44px;
  }

  /* ---------- Services ---------- */
  .services {
    padding: clamp(56px, 8vw, 104px) 0 clamp(48px, 7vw, 88px);
  }
  .cards {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    padding: 26px;
  }
  .card.lead {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .tag {
    font-family: var(--italic);
    font-style: italic;
    font-size: 17px;
    color: var(--ink-soft);
    min-height: 1.5em;
  }
  .lead .tag {
    color: rgba(234, 231, 222, 0.78);
  }
  .card h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 6px 0 14px;
    text-wrap: balance;
  }
  .blurb {
    font-size: 18px;
    line-height: 1.45;
  }
  .includes,
  .good {
    font-size: 16px;
    line-height: 1.45;
    margin-top: 14px;
    color: var(--ink-soft);
  }
  .lead .includes,
  .lead .good {
    color: rgba(234, 231, 222, 0.78);
  }
  .k {
    font-family: var(--italic);
    font-style: italic;
    color: var(--ink);
    margin-right: 4px;
  }
  .lead .k {
    color: var(--paper);
  }
  .price {
    font-family: var(--display);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: auto;
    padding-top: 22px;
  }
  .pick {
    margin-top: 16px;
    justify-content: center;
    min-height: 52px;
    text-align: center;
    background: transparent;
    color: var(--ink);
  }
  .pick:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .lead .pick {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .lead .pick:hover {
    background: transparent;
    color: var(--paper);
  }
  .foot-note {
    margin-top: 24px;
    font-family: var(--italic);
    font-style: italic;
    font-size: 17px;
    color: var(--ink-soft);
  }

  /* ---------- How it works ---------- */
  .how {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .how .kicker,
  .how .section-head h2 {
    color: var(--paper);
  }
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }
  .step {
    border-top: 1px solid rgba(234, 231, 222, 0.4);
    padding-top: 18px;
  }
  .n {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(64px, 8vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .step h3 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.025em;
    margin: 16px 0 10px;
    text-wrap: balance;
  }
  .step p {
    font-size: 18px;
    line-height: 1.5;
    color: rgba(234, 231, 222, 0.85);
    max-width: 34ch;
  }

  /* ---------- Why ---------- */
  .why {
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .why-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
  }
  .portrait {
    border: 2px solid var(--ink);
    box-shadow: 14px 14px 0 var(--ink);
    background: var(--accent);
    max-width: 380px;
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
  }
  .why-copy h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 58px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin: 12px 0 22px;
    text-wrap: balance;
  }
  .facts {
    list-style: none;
    display: grid;
    gap: 12px;
    max-width: 52ch;
  }
  .facts li {
    font-size: 20px;
    line-height: 1.45;
    padding-left: 20px;
    position: relative;
  }
  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 2px;
    background: var(--ink);
  }
  .approach {
    margin-top: 20px;
    font-size: 19px;
    line-height: 1.55;
    max-width: 52ch;
    color: var(--ink-soft);
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .quote {
    background: var(--card);
    border: 1px solid var(--line);
    padding: 24px;
  }
  .quote blockquote {
    font-size: 20px;
    line-height: 1.45;
  }
  .quote figcaption {
    margin-top: 14px;
    font-family: var(--italic);
    font-style: italic;
    font-size: 16px;
    color: var(--ink-soft);
  }

  /* ---------- FAQ ---------- */
  .faq {
    background: var(--panel);
    border-top: 1px solid var(--line);
    padding: clamp(56px, 8vw, 104px) 0;
  }
  .qa {
    max-width: 820px;
    border-bottom: 1px solid var(--ink);
  }
  details {
    border-top: 1px solid var(--ink);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(19px, 2vw, 23px);
    letter-spacing: -0.015em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span:first-child {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .chev {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
  }
  .chev::before,
  .chev::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 2px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease);
  }
  .chev::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }
  details[open] .chev::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  details p {
    font-size: 19px;
    line-height: 1.55;
    max-width: 60ch;
    padding: 0 0 22px;
  }

  /* ---------- Contact ---------- */
  .contact {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(56px, 8vw, 104px) 0;
    border-bottom: 1px solid rgba(234, 231, 222, 0.14);
  }
  .contact-flag {
    color: var(--paper);
    margin-bottom: clamp(24px, 4vw, 44px);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .contact h2 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .contact-copy p {
    margin-top: 20px;
    font-size: 20px;
    line-height: 1.5;
    max-width: 34ch;
    color: rgba(234, 231, 222, 0.88);
  }
  .form-card {
    background: var(--card);
    color: var(--ink);
    padding: clamp(22px, 3.4vw, 36px);
    border: 2px solid var(--paper);
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .tag:empty {
      display: none;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .why-grid,
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 300px;
      margin: 0 14px 14px 0;
    }
  }
  @media (max-width: 700px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .cta .btn {
      width: 100%;
      justify-content: center;
    }
    .ledger ul {
      justify-content: flex-start;
      gap: 6px 22px;
    }
  }
</style>
